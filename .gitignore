node_modules/
dist/
logs/
*.log

# collected by i18next's saveMissing outside production — a working note
# for whoever writes the translations, never a source file
**/modules/*/i18n/*.missing.json

# The example's .envs/.env.<mode> files are committed deliberately: this is
# the reference app, its values are throwaway dev defaults, and a clone must
# be able to run it. A scaffolded app is the opposite — `tulipes init`
# git-ignores .envs/ entirely, since those files hold working credentials.
.env
.env.local
.envs/.env.*.local

# Vitest artifacts
.vitest/
coverage/
reports/
.artifacts/

# packed into the CLI at prepack from example/ and packages/*/package.json
packages/cli/templates/app/
packages/cli/templates/versions.json

# Astro build cache for the docs site
site/.astro/
