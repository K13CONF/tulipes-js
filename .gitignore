node_modules/
dist/
logs/
*.log

# collected by i18next's saveMissing outside production — a working note
# for whoever writes the translations, never a source file
**/modules/*/i18n/*.missing.json

# local env overrides — .envs/.env.<mode> files ARE committed in the example,
# real apps keep secrets out of git via .env.local
.env.local
.envs/.env.*.local

# yarn berry
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
.pnp.*
