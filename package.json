{
  "name": "forgex",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "example",
    "example/modules/*"
  ],
  "scripts": {
    "example": "yarn workspace @forgex-example/app dev",
    "typecheck": "yarn workspaces foreach -A --no-private run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
