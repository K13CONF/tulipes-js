{
  "name": "tulipes",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "scripts": {
    "example": "pnpm --filter @tulipes-example/app dev",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc -p tsconfig.tests.json --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@vitest/coverage-v8": "^5.0.0",
    "ioredis": "^5",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "pnpm": {
    "overrides": {
      "pm2>js-yaml": "4.3.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
