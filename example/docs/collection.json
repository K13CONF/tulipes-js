            "method": "POST",
            "description": "A named, revocable bearer limited to scopes; the secret is returned once",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "en",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/tokens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "tokens"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"string\",\n  \"scopes\": [\n    \"string\"\n  ],\n  \"expires_in_days\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": []
        },
        {
          "name": "List API tokens",
          "request": {
            "method": "GET",
