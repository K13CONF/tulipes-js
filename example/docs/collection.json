                  "description": "JSON: [[\"field\",\"asc\"|\"desc\"], …]. Sortable: created_at, email, role; when grouped, the group keys and count"
                },
                {
                  "key": "filter",
                  "value": "string",
                  "disabled": true,
                  "description": "JSON: [[field, operator, value], [\"or\" | \"and\", …conditions], …]. Filterable: role (string: = != in); email (string: = like starts); created_at (date: > >= < <=)"
