{
  "app": {
    "name": "tulipes-example"
  },
  "authorization": "acl",
  "modules": [
    {
      "name": "hello",
      "summary": "Greets callers and counts how often each greeting is used.",
      "tools": [
        "hello_web_greetings",
        "hello_bo_greetings_reset"
      ]
    }
  ],
  "tools": [
    {
      "name": "hello_web_greetings",
      "module": "hello",
      "permission": "hello:web:greetings",
      "description": "The stored greetings, with how often each was used",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "read_only": true
    },
    {
      "name": "hello_bo_greetings_reset",
      "module": "hello",
      "permission": "hello:bo:greetings:reset",
      "description": "Reset the usage counter of every greeting to zero",
      "input_schema": {
        "type": "object",
        "properties": {
          "confirm": {
            "description": "Set to true to confirm the reset",
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "confirm"
        ],
        "additionalProperties": false
      },
      "read_only": false
    }
  ]
}
