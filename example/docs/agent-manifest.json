    {
      "name": "hello_greet",
      "module": "hello",
      "permission": "hello:greet",
      "title": "Greet",
      "description": "A greeting in the caller's language",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "read_only": true,
      "transport": {
        "kind": "http",
        "method": "GET",
        "path": "/api/v1/hello"
      }
    },
    {
      "name": "hello_greet-name",
      "module": "hello",
      "permission": "hello:greet-name",
      "title": "Greet by name",
      "description": "Greet by name",
      "input_schema": {
        "type": "object",
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "params"
        ],
        "additionalProperties": false
      },
      "read_only": true,
      "transport": {
        "kind": "http",
        "method": "GET",
        "path": "/api/v1/hello/:name"
      }
    },
    {
      "name": "hello_list-greetings",
      "module": "hello",
      "permission": "hello:list-greetings",
      "title": "List greetings",
      "description": "The stored greetings, with how often each was used",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "read_only": true,
      "transport": {
        "kind": "http",
        "method": "GET",
        "path": "/api/v1/greetings"
      }
    },
    {
      "name": "hello_use-greeting",
      "module": "hello",
      "permission": "hello:use-greeting",
      "title": "Use a greeting",
      "description": "Queues a job that counts the use",
      "input_schema": {
        "type": "object",
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "params"
        ],
        "additionalProperties": false
      },
      "read_only": false,
      "transport": {
        "kind": "http",
        "method": "POST",
        "path": "/api/v1/greetings/:name/use"
      }
    },
    {
      "name": "hello_reset-counts",
      "module": "hello",
      "permission": "hello:reset-counts",
      "description": "Reset the usage counter of every greeting to zero",
      "input_schema": {
        "type": "object",
        "properties": {
          "confirm": {
            "description": "Set to true to confirm the reset",
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "confirm"
        ],
        "additionalProperties": false
      },
      "read_only": false,
      "transport": {
        "kind": "action"
      }
    },
    {
      "name": "config_read",
      "module": "config",
      "permission": "config:read",
      "title": "Describe the app",
      "description": "Every module in load order: manifest, declared variables (names, types, sources; secrets never), settings with schema, live values and stored version, endpoints with the roles that reach them",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "read_only": true,
      "transport": {
        "kind": "http",
        "method": "GET",
        "path": "/api/v1/config/"
      }
    },
    {
      "name": "config_describe",
      "module": "config",
      "permission": "config:describe",
      "title": "Describe one module",
      "description": "The same description for one module",
      "input_schema": {
        "type": "object",
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "module": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              }
            },
            "required": [
              "module"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "params"
        ],
        "additionalProperties": false
      },
      "read_only": true,
      "transport": {
        "kind": "http",
        "method": "GET",
        "path": "/api/v1/config/:module"
      }
    },
    {
      "name": "config_write",
      "module": "config",
      "permission": "config:write",
      "title": "Change a module's settings",
      "description": "A patch over the stored values, validated by the module's schema; a stale version is refused; applied at once in every replica, except fields tagged restart, which apply on the next boot",
      "input_schema": {
        "type": "object",
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "module": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              }
            },
            "required": [
              "module"
            ],
            "additionalProperties": false
          },
          "body": {
            "type": "object",
            "properties": {
              "values": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "version": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "values"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "params",
          "body"
        ],
        "additionalProperties": false
      },
      "read_only": false,
      "transport": {
        "kind": "http",
        "method": "PATCH",
        "path": "/api/v1/config/:module"
      }
    }
  ]
}
