    {
      "name": "users_demo-boom",
      "module": "users",
      "permission": "users:demo-boom",
      "title": "Unhandled error demo",
      "description": "Unhandled error demo",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
