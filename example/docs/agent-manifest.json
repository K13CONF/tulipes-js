{
  "app": {
    "name": "tulipes-example"
  },
  "authorization": "acl",
  "modules": [
    {
      "name": "auth",
      "tools": [
        "auth_register",
        "auth_login",
        "auth_refresh",
        "auth_logout",
        "auth_me",
        "auth_sessions",
        "auth_session-end",
        "auth_password"
      ]
    },
    {
      "name": "users",
      "tools": [
        "users_read",
        "users_delete",
        "users_read-deleted",
        "users_create",
        "users_ping",
        "users_demo-missing",
        "users_demo-boom"
      ]
    },
    {
      "name": "hello",
      "summary": "Greets callers and counts how often each greeting is used.",
      "tools": [
        "hello_greet",
        "hello_greet-name",
        "hello_list-greetings",
        "hello_use-greeting",
        "hello_reset-counts"
      ]
    },
    {
      "name": "config",
      "tools": [
        "config_read",
        "config_describe",
        "config_write"
      ]
    }
  ],
  "tools": [
    {
      "name": "auth_register",
      "module": "auth",
      "permission": "auth:register",
      "title": "Register",
      "description": "Create an account and its credential",
      "input_schema": {
        "type": "object",
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              "password": {
                "type": "string",
                "minLength": 8
              }
            },
            "required": [
              "email",
              "password"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "body"
        ],
        "additionalProperties": false
      },
      "read_only": false,
      "transport": {
        "kind": "http",
        "method": "POST",
        "path": "/api/v1/auth/register"
      }
    },
    {
      "name": "auth_login",
      "module": "auth",
      "permission": "auth:login",
      "title": "Log in",
      "description": "Exchange email and password for a token pair",
      "input_schema": {
        "type": "object",
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              "password": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "email",
              "password"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "body"
        ],
        "additionalProperties": false
      },
      "read_only": false,
      "transport": {
        "kind": "http",
        "method": "POST",
        "path": "/api/v1/auth/login"
      }
    },
    {
      "name": "auth_refresh",
      "module": "auth",
      "permission": "auth:refresh",
      "title": "Refresh tokens",
      "description": "Rotate a refresh token for a new pair",
      "input_schema": {
        "type": "object",
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "refresh_token": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "refresh_token"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "body"
        ],
        "additionalProperties": false
      },
      "read_only": false,
      "transport": {
        "kind": "http",
        "method": "POST",
        "path": "/api/v1/auth/refresh"
      }
    },
    {
      "name": "auth_logout",
      "module": "auth",
      "permission": "auth:logout",
      "title": "Log out",
      "description": "Revoke this session immediately",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "read_only": false,
      "transport": {
        "kind": "http",
        "method": "POST",
        "path": "/api/v1/auth/logout"
      }
    },
    {
      "name": "auth_me",
      "module": "auth",
      "permission": "auth:me",
      "title": "Who am I",
      "description": "The caller and the session behind this request",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "read_only": true,
      "transport": {
        "kind": "http",
        "method": "GET",
        "path": "/api/v1/auth/me"
      }
    },
    {
      "name": "auth_sessions",
      "module": "auth",
      "permission": "auth:sessions",
      "title": "List sessions",
      "description": "Every device this account is signed in on",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "read_only": true,
      "transport": {
        "kind": "http",
        "method": "GET",
        "path": "/api/v1/auth/sessions"
      }
    },
    {
      "name": "auth_session-end",
      "module": "auth",
      "permission": "auth:session-end",
      "title": "End a session",
      "description": "Sign one other device out",
      "input_schema": {
        "type": "object",
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "sid": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
              }
            },
            "required": [
              "sid"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "params"
        ],
        "additionalProperties": false
      },
      "read_only": false,
      "transport": {
        "kind": "http",
        "method": "DELETE",
        "path": "/api/v1/auth/sessions/:sid"
      }
    },
    {
      "name": "auth_password",
      "module": "auth",
      "permission": "auth:password",
      "title": "Change password",
      "description": "Set a new password and end every other session",
      "input_schema": {
        "type": "object",
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "password": {
                "type": "string",
                "minLength": 8
              }
            },
            "required": [
              "password"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "body"
        ],
        "additionalProperties": false
      },
      "read_only": false,
      "transport": {
        "kind": "http",
        "method": "POST",
        "path": "/api/v1/auth/password"
      }
    },
    {
      "name": "users_read",
      "module": "users",
      "permission": "users:read",
      "title": "List users",
      "description": "Page through accounts, clamped by the shared bounds",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "per_page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "additionalProperties": false
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "read_only": true,
      "transport": {
        "kind": "http",
        "method": "GET",
        "path": "/users/"
      }
    },
    {
      "name": "users_delete",
      "module": "users",
      "permission": "users:delete",
      "title": "Soft-delete a user",
      "description": "Flags the account; ordinary queries stop returning it",
      "input_schema": {
        "type": "object",
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              }
            },
            "required": [
              "email"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "params"
        ],
        "additionalProperties": false
      },
      "read_only": false,
      "transport": {
        "kind": "http",
        "method": "DELETE",
        "path": "/users/:email"
      }
    },
    {
      "name": "users_read-deleted",
      "module": "users",
      "permission": "users:read-deleted",
      "title": "List soft-deleted users",
      "description": "List soft-deleted users",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "read_only": true,
