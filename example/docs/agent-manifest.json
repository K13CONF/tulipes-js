      "title": "Users module status",
      "description": "Users module status",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "read_only": true,
      "transport": {
        "kind": "http",
        "method": "GET",
        "path": "/users/ping"
      }
    },
    {
      "name": "users_demo-missing",
