        "kind": "http",
        "method": "GET",
        "path": "/users/deleted"
      }
    },
    {
      "name": "users_create",
      "module": "users",
      "permission": "users:create",
      "title": "Create a user",
      "description": "Adds the account and queues its welcome email",
      "input_schema": {
        "type": "object",
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              }
            },
            "required": [
