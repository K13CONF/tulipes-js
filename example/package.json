{
  "name": "@tulipes-example/app",
  "tulipes": {
    "providers": {
      "models": "@tulipes/mongoose",
      "queues": "@tulipes/bullmq",
      "sockets": "@tulipes/socket.io"
    }
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tulipes dev",
    "worker": "tsx worker.ts",
    "sync": "tulipes sync",
    "check": "tulipes env:check",
    "typecheck": "tsc --noEmit",
    "script": "tsx",
    "spec": "tulipes spec --offline --openapi docs/openapi.json --postman docs/collection.json",
    "test": "vitest run",
    "start": "tsx app.ts"
  },
  "dependencies": {
    "@tulipes/bullmq": "workspace:*",
    "@tulipes/core": "workspace:*",
    "@tulipes/mongoose": "workspace:*",
    "@tulipes/socket.io": "workspace:*",
    "ioredis": "^5",
    "mongoose": "^8",
    "zod": "^3.25"
  },
  "devDependencies": {
    "@tulipes/cli": "workspace:*",
    "@tulipes/spec": "workspace:*",
    "@types/express": "^5",
    "@types/jsonwebtoken": "^9",
    "jsonwebtoken": "^9",
    "pm2": "^7.0.4",
    "socket.io-client": "^4",
    "typescript": "^7",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
