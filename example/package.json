{
  "name": "@tulipes-example/app",
  "tulipes": {
    "providers": {
      "models": "@tulipes/mongoose",
      "settings": "@tulipes/mongoose/settings",
      "queues": "@tulipes/bullmq",
      "sockets": "@tulipes/socket.io"
    }
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tulipes dev",
    "worker": "node worker.ts",
    "mcp": "node mcp.ts",
    "sync": "tulipes sync",
    "check": "tulipes env:check",
    "typecheck": "tsc --noEmit",
    "script": "node",
    "spec": "tulipes spec --openapi docs/openapi.json --postman docs/collection.json",
    "manifest": "tulipes agent manifest --out docs/agent-manifest.json",
    "test": "vitest run",
    "start": "node app.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:start:staging": "pm2 start ecosystem.config.cjs --env staging",
    "pm2:start:production": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@tulipes/bullmq": "workspace:*",
    "@tulipes/core": "workspace:*",
    "@tulipes/mcp": "workspace:*",
    "@tulipes/mongoose": "workspace:*",
    "@tulipes/socket.io": "workspace:*",
    "ioredis": "^5",
    "mongoose": "^8",
    "zod": "^3.25"
  },
  "devDependencies": {
    "@tulipes/cli": "workspace:*",
    "@tulipes/spec": "workspace:*",
    "@tulipes/testing": "workspace:*",
    "@types/express": "^5",
    "@types/jsonwebtoken": "^9",
    "@types/node": "^24",
    "jsonwebtoken": "^9",
    "pm2": "^7.0.4",
    "typescript": "^7",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
