{
  "name": "@tulipes-example/app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tulipes dev",
    "worker": "tsx worker.ts",
    "sync": "tulipes sync",
    "check": "tulipes env:check",
    "typecheck": "tsc --noEmit",
    "script": "tsx",
    "spec": "tulipes spec --offline --openapi docs/openapi.json --postman docs/collection.json",
    "test": "vitest run",
    "start": "tsx app.ts"
  },
  "dependencies": {
    "@tulipes/core": "workspace:*",
    "ioredis": "^5",
    "mongoose": "^8",
    "zod": "^3.25"
  },
  "devDependencies": {
    "@tulipes/spec": "workspace:*",
    "pm2": "^7.0.4",
    "socket.io-client": "^4",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
