{
  "name": "@app/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./lib/index.ts"
  },
  "tulipes": {
    "tier": "sys",
    "priority": 20,
    "env": [
      {
        "name": "JWT_ACCESS_SECRET",
        "type": "secret",
        "group": "auth",
        "required": true,
        "description": "Signing key for short-lived access tokens"
      },
      {
        "name": "JWT_REFRESH_SECRET",
        "type": "secret",
        "group": "auth",
        "required": true,
        "description": "Signing key for refresh tokens; separate from the access key so leaking one cannot mint the other"
      },
      {
        "name": "AUTH_ADMIN_EMAIL",
        "type": "string",
        "group": "auth",
        "required": true,
        "description": "Email of the admin account seeded on first boot"
      },
      {
        "name": "AUTH_ADMIN_PASSWORD",
        "type": "secret",
        "group": "auth",
        "required": true,
        "description": "Password for the seeded admin account; change it after the first login"
      }
    ]
  },
  "dependencies": {
    "@app/core": "workspace:*",
    "@tulipes/core": "workspace:*",
    "@tulipes/mongoose": "workspace:*",
    "bcryptjs": "^3",
    "express": "^5",
    "jsonwebtoken": "^9",
    "mongoose": "^8",
    "passport": "^0.7",
    "passport-jwt": "^4",
    "passport-local": "^1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9",
    "@types/passport": "^1",
    "@types/passport-jwt": "^4",
    "@types/passport-local": "^1"
  }
}
