{
  "name": "@app/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "tulipes": {
    "tier": "sys",
    "priority": 0,
    "env": {
      "port": {
        "key": "PORT",
        "type": "number",
        "group": "http",
        "description": "HTTP port the backend process listens on",
        "default": 3000
      },
      "mongodbUri": {
        "key": "MONGO_URI",
        "type": "url",
        "group": "database",
        "description": "Full MongoDB connection string; when set it wins over the parts below (the only way to name a replica set, an Atlas mongodb+srv:// cluster or driver options)"
      },
      "mongodbHost": {
        "key": "MONGO_HOST",
        "type": "url",
        "group": "database",
        "description": "MongoDB host as a URI without credentials or database: mongodb://host:port",
        "default": "mongodb://localhost:27017"
      },
      "mongodbUsername": {
        "key": "MONGO_USERNAME",
        "type": "string",
        "group": "database",
        "description": "MongoDB username; empty for an unauthenticated server",
        "default": ""
      },
      "mongodbPassword": {
        "key": "MONGO_PASSWORD",
        "type": "secret",
        "group": "database",
        "description": "MongoDB password",
        "default": ""
      },
      "mongodbDbName": {
        "key": "MONGO_DBNAME",
        "type": "string",
        "group": "database",
        "description": "MongoDB database name",
        "default": "tulipes_example"
      },
      "redisUrl": {
        "key": "REDIS_URL",
        "type": "url",
        "group": "redis",
        "required": true,
        "description": "Redis connection string (queues, cache, rate limits)"
      },
      "logLevel": {
        "key": "LOG_LEVEL",
        "type": "enum",
        "enum": [
          "fatal",
          "error",
          "warn",
          "info",
          "debug",
          "trace"
        ],
        "group": "logging",
        "description": "Lowest level that reaches any destination",
        "default": "info"
      },
      "logConsole": {
        "key": "LOG_CONSOLE",
        "type": "boolean",
        "group": "logging",
        "description": "Pretty coloured logs on stdout; turn off where a collector reads files only",
        "default": true
      },
      "logFile": {
        "key": "LOG_FILE",
        "type": "boolean",
        "group": "logging",
        "description": "Write JSON-line log files under LOG_DIR",
        "default": true
      },
      "logDir": {
        "key": "LOG_DIR",
        "type": "string",
        "group": "logging",
        "description": "Directory for log files, relative to the app root or absolute",
        "default": "logs"
      }
    }
  },
  "dependencies": {
    "@tulipes/core": "workspace:*",
    "ioredis": "^5",
    "mongoose": "^8",
    "pino": "^9",
    "pino-pretty": "^13",
    "pino-roll": "^3"
  },
  "exports": {
    ".": "./lib/index.ts"
  }
}
