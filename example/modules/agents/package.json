{
  "name": "@app/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "tulipes": {
    "tier": "app",
    "priority": 960,
    "dependsOn": [
      "auth",
      "core"
    ],
    "env": {
      "anthropicApiKey": {
        "key": "ANTHROPIC_API_KEY",
        "type": "secret",
        "group": "agents",
        "description": "Claude API key for agent runs; unset, the app boots and serves MCP as usual and starting a run answers 503"
      },
      "anthropicBaseUrl": {
        "key": "ANTHROPIC_BASE_URL",
        "type": "url",
        "group": "agents",
        "description": "Another endpoint for the Claude API (a proxy or a gateway); unset is the API itself"
      }
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@app/auth": "workspace:*",
    "@app/core": "workspace:*",
    "@tulipes/bullmq": "workspace:*",
    "@tulipes/core": "workspace:*",
    "@tulipes/mongoose": "workspace:*",
    "express": "^5",
    "mongoose": "^8",
    "zod": "^4.6.6"
  }
}
