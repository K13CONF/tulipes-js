# AUTO-GENERATED by `tulipes sync` from every module's package.json tulipes.env.
# Copy into .envs/.env.<mode> and fill in the blanks.

# ━━━ core ━━━

# ── http ──
# HTTP port the backend process listens on (number) → config.core.port
PORT=3000

# ── database ──
# Full MongoDB connection string; when set it wins over the parts below (the only way to name a replica set, an Atlas mongodb+srv:// cluster or driver options) (url) → config.core.mongodbUri
MONGO_URI=
# MongoDB host as a URI without credentials or database: mongodb://host:port (url) → config.core.mongodbHost
MONGO_HOST=mongodb://localhost:27017
# MongoDB username; empty for an unauthenticated server (string) → config.core.mongodbUsername
MONGO_USERNAME=
# MongoDB password (secret) → config.core.mongodbPassword
MONGO_PASSWORD=
# MongoDB database name (string) → config.core.mongodbDbName
MONGO_DBNAME=tulipes_example

# ── redis ──
# Redis connection string (queues, cache, rate limits) (url, REQUIRED) → config.core.redisUrl
REDIS_URL=

# ── logging ──
# Lowest level that reaches any destination (enum: fatal | error | warn | info | debug | trace) → config.core.logLevel
LOG_LEVEL=info
# Pretty coloured logs on stdout; turn off where a collector reads files only (boolean) → config.core.logConsole
LOG_CONSOLE=true
# Write JSON-line log files under LOG_DIR (boolean) → config.core.logFile
LOG_FILE=true
# Directory for log files, relative to the app root or absolute (string) → config.core.logDir
LOG_DIR=logs

# ━━━ auth ━━━

# ── auth ──
# Signing key for short-lived access tokens (secret, REQUIRED) → config.auth.jwtAccessSecret
JWT_ACCESS_SECRET=
# Signing key for refresh tokens; separate from the access key so leaking one cannot mint the other (secret, REQUIRED) → config.auth.jwtRefreshSecret
JWT_REFRESH_SECRET=
# Email of the admin account seeded on first boot (string, REQUIRED) → config.auth.adminEmail
AUTH_ADMIN_EMAIL=
# Password for the seeded admin account; change it after the first login (secret, REQUIRED) → config.auth.adminPassword
AUTH_ADMIN_PASSWORD=
