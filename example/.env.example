# AUTO-GENERATED by `tulipes sync` from every module's meta.variables.json.
# Copy into .envs/.env.<mode> and fill in the blanks.

# ━━━ core ━━━

# ── http ──
# HTTP port the backend process listens on (number)
PORT=3000

# ── database ──
# MongoDB connection string (url, REQUIRED)
MONGO_URI=

# ── redis ──
# Redis connection string (queues, cache) (url, REQUIRED)
REDIS_URL=

# ── deploy ──
# Public hostname this API is served from; "localhost" means not deployed (string)
PUBLIC_DOMAIN=localhost

# ── logging ──
# Lowest level that reaches any destination (enum: fatal | error | warn | info | debug | trace)
LOG_LEVEL=info
# Pretty coloured logs on stdout; turn off where a collector reads files only (boolean)
LOG_CONSOLE=true
# Write JSON-line log files under LOG_DIR (boolean)
LOG_FILE=true
# Directory for log files, relative to the app root or absolute (string)
LOG_DIR=logs
# Base name of the all-levels log file; the process mode and date are appended (string)
LOG_BASENAME=app
# Base name of the errors-only log file; the process mode and date are appended (string)
LOG_ERROR_BASENAME=error
# Rotate on this schedule: "daily", "hourly", or milliseconds (string)
LOG_ROTATION_FREQUENCY=daily
# Also rotate once a file reaches this size, e.g. "20m" (string)
LOG_ROTATION_SIZE=20m
# How many rotated files to keep per destination, besides the current one (number)
LOG_RETENTION_FILES=14

# ━━━ security ━━━

# ── http ──
# Largest JSON request body express will parse, e.g. "1mb"; nginx client_max_body_size must be at least this (string)
BODY_LIMIT=1mb
# Comma-separated trusted proxy IP addresses or CIDRs; empty ignores forwarded headers. Configure only actual proxy peers. (string)
TRUST_PROXY_CIDRS=

# ── cors ──
# Comma-separated browser origins allowed to read API responses; "*" allows any, empty allows none (same-origin only) (string)
CORS_ORIGINS=
# Emit Access-Control-Allow-Credentials for browser credential mode; does not enable cookie authentication or CSRF protection (cannot be combined with CORS_ORIGINS=*) (boolean)
CORS_CREDENTIALS=false

# ── hardening ──
# Strict-Transport-Security max-age in seconds; 0 disables the header (browsers only honour it over HTTPS) (number)
HSTS_MAX_AGE=15552000

# ── rate-limits ──
# Stable identifier shared by replicas; use a different value for unrelated apps on the same Redis database (string)
RATE_LIMIT_NAMESPACE=tulipes
# Fixed request window in milliseconds; positive integer, applied on restart (number)
RATE_LIMIT_WINDOW_MS=60000
# Combined login, register and password POST attempts per client per window; positive integer (number)
AUTH_RATE_LIMIT=20
# All auth requests per client per window, including refresh and credential attempts; positive integer (number)
AUTH_SESSION_RATE_LIMIT=120
# All settings requests per client per window; positive integer (number)
SETTINGS_RATE_LIMIT=60

# ━━━ auth ━━━

# ── auth ──
# Signing key for short-lived access tokens (secret, REQUIRED)
JWT_ACCESS_SECRET=
# Signing key for refresh tokens; separate from the access key so leaking one cannot mint the other (secret, REQUIRED)
JWT_REFRESH_SECRET=
# Access token lifetime, as an ms/jsonwebtoken duration. Keep it short: a revoked user keeps their role until it expires (string)
JWT_ACCESS_TTL=15m
# Refresh token lifetime; also the TTL on its database record (string)
JWT_REFRESH_TTL=30d
# Email of the admin account seeded on first boot (string, REQUIRED)
AUTH_ADMIN_EMAIL=
# Password for the seeded admin account; change it after the first login (secret, REQUIRED)
AUTH_ADMIN_PASSWORD=

# ━━━ users ━━━

# ── sessions ──
# Max concurrent sessions per user (number)
USERS_MAX_SESSIONS=5
# Who can register (enum: open | invite | closed)
USERS_SIGNUP_MODE=open

# ━━━ hello ━━━

# ── hello ──
# Word this module greets callers with (string)
HELLO_GREETING=Hello
