# AUTO-GENERATED by `tulipes sync` from every module's package.json tulipes.env.
# Copy into .envs/.env.<mode> and fill in the blanks.

# ━━━ core ━━━

# ── http ──
# HTTP port the backend process listens on (number)
PORT=3000

# ── database ──
# MongoDB connection string (url, REQUIRED)
MONGO_URI=

# ── redis ──
# Redis connection string (queues, cache) (url, REQUIRED)
REDIS_URL=

# ── logging ──
# Lowest level that reaches any destination (enum: fatal | error | warn | info | debug | trace)
LOG_LEVEL=info
# Pretty coloured logs on stdout; turn off where a collector reads files only (boolean)
LOG_CONSOLE=true
# Write JSON-line log files under LOG_DIR (boolean)
LOG_FILE=true
# Directory for log files, relative to the app root or absolute (string)
LOG_DIR=logs

# ━━━ auth ━━━

# ── auth ──
# Signing key for short-lived access tokens (secret, REQUIRED)
JWT_ACCESS_SECRET=
# Signing key for refresh tokens; separate from the access key so leaking one cannot mint the other (secret, REQUIRED)
JWT_REFRESH_SECRET=
# Email of the admin account seeded on first boot (string, REQUIRED)
AUTH_ADMIN_EMAIL=
# Password for the seeded admin account; change it after the first login (secret, REQUIRED)
AUTH_ADMIN_PASSWORD=
