# AUTO-GENERATED by `tulipes sync` from every module's meta.variables.json.
# Copy into .envs/.env.<mode> and fill in the blanks.

# ━━━ core ━━━

# ── http ──
# HTTP port the web process listens on (number)
PORT=3000

# ── database ──
# MongoDB connection string (url, REQUIRED)
MONGO_URI=

# ── redis ──
# Redis connection string (cache, queues, rate limiting) (url, REQUIRED)
REDIS_URL=

# ── security ──
# Signing key for access tokens (secret, REQUIRED)
JWT_SECRET=

# ━━━ security ━━━

# ── logging ──
# Minimum pino log level (enum: fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# ── cors ──
# Comma-separated browser origins allowed to call this API; "*" allows any, empty allows none (same-origin only) (string)
CORS_ORIGINS=
# Allow cookies and Authorization headers on cross-origin requests (cannot be combined with CORS_ORIGINS=*) (boolean)
CORS_CREDENTIALS=false

# ── hardening ──
# Strict-Transport-Security max-age in seconds; 0 disables the header (browsers only honour it over HTTPS) (number)
HSTS_MAX_AGE=15552000

# ━━━ users ━━━

# ── sessions ──
# Max concurrent sessions per user (number)
USERS_MAX_SESSIONS=5
# Who can register (enum: open | invite | closed)
USERS_SIGNUP_MODE=open
# Seeded admin account email (string, REQUIRED)
USERS_ADMIN_EMAIL=
