# Staging. NOT committed — .gitignore excludes .envs/. Recreate it on
# the deployment host from .env.example, or leave it out entirely and
# inject everything through the container environment.
#
# The blanks below are intentional. Real deployments inject MONGO_URI,
# REDIS_URL and any secret through the container environment, which
# always wins over this file. Booting without them fails closed with a
# report naming every missing variable — run `pnpm check` to see it
# without starting the app.

PORT=3000
LOG_LEVEL=info

# MONGO_URI=
# REDIS_URL=
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# AUTH_ADMIN_EMAIL=
# AUTH_ADMIN_PASSWORD=
