# Production. Committed like the development file: it holds structure and
# non-secret defaults, never credentials.
#
# The blanks below are intentional. Real deployments inject MONGO_URI,
# REDIS_URL and any secret through the container environment, which always
# wins over this file. Booting without them fails closed with a report
# naming every missing variable — run `pnpm check` to see it without
# starting the app.

PORT=4000
LOG_LEVEL=info

# The hostname nginx serves this app from; also the filename the deploy
# script writes into sites-available.
PUBLIC_DOMAIN=
CORS_ORIGINS=

# MONGO_URI=
# REDIS_URL=
# JWT_SECRET=
# USERS_ADMIN_EMAIL=
