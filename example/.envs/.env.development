# Development. NOT committed — .gitignore excludes .envs/, because a
# file holding working credentials does not belong in a repository.
# The committed contract is .env.example at the root: copy it here and
# fill it in. Real deployments inject variables through the container
# environment, which always wins over this file.

PORT=3000
LOG_LEVEL=debug

MONGO_URI=mongodb://127.0.0.1:27017/tulipes-example
REDIS_URL=redis://127.0.0.1:6379

# Auth. Separate keys, so leaking one cannot mint the other.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=dev-admin-password

