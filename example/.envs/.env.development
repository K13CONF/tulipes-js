# Development mode — committed on purpose in the example app.
# Real deployments inject secrets via the container environment, which
# always wins over this file.

PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/tulipes-example
REDIS_URL=redis://127.0.0.1:6379

USERS_SIGNUP_MODE=invite

# Local frontend dev server. Empty (the default) would allow no browser
# origin at all; "*" allows any but forbids credentials.
CORS_ORIGINS=http://localhost:5173

# Public hostname. "localhost" means not deployed; the nginx deploy
# script refuses until this is a real domain.
PUBLIC_DOMAIN=localhost

# Auth. Separate keys so leaking one cannot mint the other.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=dev-admin-password
