{
  "name": "@tulipes/socket.io",
  "version": "0.1.4",
  "description": "Socket.IO sockets provider for Tulipes apps: module-owned namespaces on the backend's HTTP server, behind core's sockets capability",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js"
    }
  },
  "dependencies": {
    "socket.io": "^4"
  },
  "peerDependencies": {
    "@tulipes/core": "^0.11.0 || ^0.12.0 || ^0.13.0"
  },
  "devDependencies": {
    "@tulipes/core": "workspace:*",
    "@types/node": "^24.2.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K13CONF/tulipes-js.git",
    "directory": "packages/socket.io"
  },
  "keywords": [
    "tulipes",
    "socket.io",
    "websocket",
    "express"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "homepage": "https://github.com/K13CONF/tulipes-js/tree/master/packages/socket.io#readme",
  "bugs": {
    "url": "https://github.com/K13CONF/tulipes-js/issues"
  }
}
