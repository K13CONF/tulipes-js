{
  "name": "@tulipes/mongoose",
  "version": "0.2.2",
  "description": "Mongoose models provider for Tulipes apps: connection, model registration and bootstrap behind core's models capability",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./settings": "./src/settings-provider.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./settings": "./dist/settings-provider.js"
    }
  },
  "peerDependencies": {
    "@tulipes/core": "^0.13.0",
    "mongoose": "^8"
  },
  "devDependencies": {
    "@tulipes/core": "workspace:*",
    "@types/node": "^24.2.0",
    "mongoose": "^8",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K13CONF/tulipes-js.git",
    "directory": "packages/mongoose"
  },
  "keywords": [
    "tulipes",
    "mongoose",
    "mongodb",
    "express"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "homepage": "https://github.com/K13CONF/tulipes-js/tree/master/packages/mongoose#readme",
  "bugs": {
    "url": "https://github.com/K13CONF/tulipes-js/issues"
  }
}
