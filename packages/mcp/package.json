{
  "name": "@tulipes/mcp",
  "version": "0.2.1",
  "description": "MCP server over a Tulipes app's agent manifest: its tools, served on stdio, called through the app's own HTTP door",
  "type": "module",
  "bin": {
    "tulipes-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@tulipes/core": "workspace:*",
    "@types/node": "^24.2.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K13CONF/tulipes-js.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "tulipes",
    "mcp",
    "agent",
    "tools"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "homepage": "https://github.com/K13CONF/tulipes-js/tree/master/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/K13CONF/tulipes-js/issues"
  },
  "peerDependencies": {
    "@tulipes/core": "^0.13.0"
  }
}
