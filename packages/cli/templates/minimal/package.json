{
  "name": "tulipes-example",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "tulipes dev",
    "start": "node app.ts",
    "mcp": "node mcp.ts",
    "sync": "tulipes sync",
    "check": "tulipes env:check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spec": "tulipes spec --openapi docs/openapi.json --postman docs/collection.json"
  },
  "dependencies": {
    "@tulipes/core": "workspace:*",
    "@tulipes/mcp": "workspace:*",
    "express": "^5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tulipes/cli": "workspace:*",
    "@tulipes/spec": "workspace:*",
    "@tulipes/testing": "workspace:*",
    "@types/express": "^5",
    "@types/node": "^24",
    "typescript": "^7",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
