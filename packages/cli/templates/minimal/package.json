{
  "name": "tulipes-example",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "tulipes dev",
    "start": "tsx app.ts",
    "sync": "tulipes sync",
    "check": "tulipes env:check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spec": "tulipes spec --offline --openapi docs/openapi.json --postman docs/collection.json"
  },
  "dependencies": {
    "@tulipes/core": "^0.10.1",
    "express": "^5",
    "zod": "^3.25"
  },
  "devDependencies": {
    "@tulipes/cli": "^0.1.1",
    "@tulipes/spec": "^0.3.1",
    "@types/express": "^5",
    "@types/node": "^24",
    "tsx": "^4",
    "typescript": "^7",
    "vitest": "^5.0.0",
    "vite": "^8.2.2"
  }
}
