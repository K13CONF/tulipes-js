{
  "name": "@tulipes/core",
  "version": "0.1.0",
  "description": "Module-based Express framework: convention-driven boot pipeline, env contracts, ACL, queues, sockets and CLI",
  "type": "module",
  "bin": {
    "tulipes": "./bin/tulipes.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env/index.ts",
    "./modules": "./src/modules/index.ts",
    "./boot": "./src/boot/index.ts",
    "./acl": "./src/acl/index.ts",
    "./db": "./src/db/index.ts",
    "./queues": "./src/queues/index.ts",
    "./sockets": "./src/sockets/index.ts",
    "./http": "./src/http/index.ts",
    "./config": "./src/config/index.ts",
    "./errors": "./src/errors/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "prepack": "yarn build"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "tulipes": "./dist/cli/bin.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./env": "./dist/env/index.js",
      "./modules": "./dist/modules/index.js",
      "./boot": "./dist/boot/index.js",
      "./acl": "./dist/acl/index.js",
      "./db": "./dist/db/index.js",
      "./queues": "./dist/queues/index.js",
      "./sockets": "./dist/sockets/index.js",
      "./http": "./dist/http/index.js",
      "./config": "./dist/config/index.js",
      "./errors": "./dist/errors/index.js"
    }
  },
  "dependencies": {
    "bullmq": "^5",
    "colorette": "^2",
    "dotenv": "^16.4.7",
    "express": "^5",
    "ioredis": "^5",
    "mongoose": "^8",
    "socket.io": "^4",
    "tsx": "^4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/node": "^24.2.0",
    "typescript": "^7.0.2"
  }
}
